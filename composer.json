{
    "name": "fnx-software/subbase-payment",
    "description": "FNX Software reusable subscription payment gateways for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "laravel",
        "subscription",
        "payment",
        "billing"
    ],
    "homepage": "https://github.com/fnx-software/subbase-payment",
    "authors": [
        {
            "name": "Nafis Watsiq",
            "email": "nafiswatsiq@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "ext-bcmath": "*",
        "fnx-software/subbase": "dev-feat/universal-billing-foundation"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "orchestra/testbench": "^11.3",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Nafiswatsiq\\SubbasePayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nafiswatsiq\\SubbasePayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nafiswatsiq\\SubbasePayment\\SubbasePaymentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/fnx-software/subbase",
            "canonical": true
        }
    ],
    "support": {
        "source": "https://github.com/fnx-software/subbase-payment",
        "issues": "https://github.com/fnx-software/subbase-payment/pulls"
    }
}
